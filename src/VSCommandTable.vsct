<?xml version="1.0" encoding="utf-8"?>
<CommandTable xmlns="http://schemas.microsoft.com/VisualStudio/2005-10-18/CommandTable" xmlns:xs="http://www.w3.org/2001/XMLSchema">

  <Extern href="stdidcmd.h"/>
  <Extern href="vsshlids.h"/>
  <Include href="KnownImageIds.vsct"/>
  <Include href="VSGlobals.vsct"/>

  <Commands package="CSVEditor">
    <Groups>
      <Group guid="CSVEditor" id="CsvMenuGroup" priority="0x0600">
        <Parent guid="VSMainMenu" id="Edit"/>
      </Group>
      <Group guid="CSVEditor" id="CsvContextMenuGroup" priority="0x0100">
        <Parent guid="guidSHLMainMenu" id="IDM_VS_CTXT_CODEWIN"/>
      </Group>
    </Groups>

    <Buttons>
      <Button guid="CSVEditor" id="GoToColumnCommand" priority="0x0100" type="Button">
        <Parent guid="CSVEditor" id="CsvMenuGroup" />
        <Icon guid="ImageCatalogGuid" id="GoToNext" />
        <CommandFlag>IconIsMoniker</CommandFlag>
        <CommandFlag>DynamicVisibility</CommandFlag>
        <CommandFlag>DefaultInvisible</CommandFlag>
        <Strings>
          <ButtonText>Go to CSV Column...</ButtonText>
          <LocCanonicalName>.CSVEditor.GoToColumnCommand</LocCanonicalName>
        </Strings>
      </Button>

      <Button guid="CSVEditor" id="AlignColumnsCommand" priority="0x0100" type="Button">
        <Parent guid="CSVEditor" id="CsvContextMenuGroup" />
        <Icon guid="ImageCatalogGuid" id="AlignLeft" />
        <CommandFlag>IconIsMoniker</CommandFlag>
        <CommandFlag>DynamicVisibility</CommandFlag>
        <!--<CommandFlag>DefaultInvisible</CommandFlag>-->
        <Strings>
          <ButtonText>Align CSV Columns</ButtonText>
          <LocCanonicalName>.CSVEditor.AlignColumnsCommand</LocCanonicalName>
        </Strings>
      </Button>
    </Buttons>
  </Commands>

  <KeyBindings>
    <KeyBinding guid="CSVEditor" id="GoToColumnCommand" editor="guidVSStd97" key1="G" mod1="Control" key2="C" mod2="Control" />
  </KeyBindings>

  <Symbols>
    <GuidSymbol name="CSVEditor" value="{55b9ed45-59d1-40dc-8003-343d792221d7}">
      <IDSymbol name="CsvMenuGroup" value="0x0001" />
      <IDSymbol name="CsvContextMenuGroup" value="0x0002" />
      <IDSymbol name="GoToColumnCommand" value="0x0100" />
      <IDSymbol name="AlignColumnsCommand" value="0x0101" />
    </GuidSymbol>
  </Symbols>
</CommandTable>
