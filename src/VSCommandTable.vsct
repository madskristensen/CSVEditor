<?xml version="1.0" encoding="utf-8"?>
<CommandTable xmlns="http://schemas.microsoft.com/VisualStudio/2005-10-18/CommandTable" xmlns:xs="http://www.w3.org/2001/XMLSchema">

  <Extern href="stdidcmd.h"/>
  <Extern href="vsshlids.h"/>
  <Include href="KnownImageIds.vsct"/>
  <Include href="VSGlobals.vsct"/>

  <Commands package="CSVEditor">
    <Groups>
      <Group guid="CSVEditor" id="CsvContextMenuGroup" priority="0x0100">
        <Parent guid="guidSHLMainMenu" id="IDM_VS_CTXT_CODEWIN"/>
      </Group>
    </Groups>

    <Buttons>
      <Button guid="CSVEditor" id="GoToColumnCommand" priority="0x0100" type="Button">
        <Parent guid="CSVEditor" id="CsvContextMenuGroup" />
        <Icon guid="ImageCatalogGuid" id="GoToNext" />
        <CommandFlag>IconIsMoniker</CommandFlag>
        <CommandFlag>DynamicVisibility</CommandFlag>
        <CommandFlag>DefaultInvisible</CommandFlag>
        <Strings>
          <ButtonText>Go to CSV Column...</ButtonText>
          <LocCanonicalName>.CSVEditor.GoToColumnCommand</LocCanonicalName>
        </Strings>
      </Button>

        <Button guid="CSVEditor" id="AlignColumnsCommand" priority="0x0100" type="Button">
          <Parent guid="CSVEditor" id="CsvContextMenuGroup" />
          <Icon guid="ImageCatalogGuid" id="AlignHorizontalStretch" />
          <CommandFlag>IconIsMoniker</CommandFlag>
          <CommandFlag>DynamicVisibility</CommandFlag>
          <CommandFlag>DefaultInvisible</CommandFlag>
          <Strings>
            <ButtonText>Align CSV Columns</ButtonText>
            <LocCanonicalName>.CSVEditor.AlignColumnsCommand</LocCanonicalName>
          </Strings>
        </Button>

        <Button guid="CSVEditor" id="ShrinkColumnsCommand" priority="0x0101" type="Button">
          <Parent guid="CSVEditor" id="CsvContextMenuGroup" />
          <Icon guid="ImageCatalogGuid" id="CollapseAll" />
          <CommandFlag>IconIsMoniker</CommandFlag>
          <CommandFlag>DynamicVisibility</CommandFlag>
          <CommandFlag>DefaultInvisible</CommandFlag>
          <Strings>
            <ButtonText>Shrink CSV Columns</ButtonText>
            <LocCanonicalName>.CSVEditor.ShrinkColumnsCommand</LocCanonicalName>
          </Strings>
        </Button>

          <Button guid="CSVEditor" id="ToggleAlternateRowsCommand" priority="0x0102" type="Button">
            <Parent guid="CSVEditor" id="CsvContextMenuGroup" />
            <Icon guid="ImageCatalogGuid" id="ThreeRows" />
            <CommandFlag>IconIsMoniker</CommandFlag>
            <CommandFlag>DynamicVisibility</CommandFlag>
            <CommandFlag>DefaultInvisible</CommandFlag>
            <Strings>
              <ButtonText>Toggle alternate row colors</ButtonText>
              <LocCanonicalName>.CSVEditor.ToggleAlternateRowsCommand</LocCanonicalName>
            </Strings>
          </Button>

          <Button guid="CSVEditor" id="CopyAsMarkdownCommand" priority="0x0103" type="Button">
            <Parent guid="CSVEditor" id="CsvContextMenuGroup" />
            <Icon guid="ImageCatalogGuid" id="MarkdownFile" />
            <CommandFlag>IconIsMoniker</CommandFlag>
            <CommandFlag>DynamicVisibility</CommandFlag>
            <CommandFlag>DefaultInvisible</CommandFlag>
            <Strings>
              <ButtonText>Copy as Markdown Table</ButtonText>
              <LocCanonicalName>.CSVEditor.CopyAsMarkdownCommand</LocCanonicalName>
            </Strings>
          </Button>
        </Buttons>
  </Commands>

  <VisibilityConstraints>
    <VisibilityItem guid="CSVEditor" id="AlignColumnsCommand" context="ContentType" />
    <VisibilityItem guid="CSVEditor" id="GoToColumnCommand" context="ContentType" />
    <VisibilityItem guid="CSVEditor" id="ShrinkColumnsCommand" context="ContentType" />
    <VisibilityItem guid="CSVEditor" id="ToggleAlternateRowsCommand" context="ContentType" />
    <VisibilityItem guid="CSVEditor" id="CopyAsMarkdownCommand" context="ContentType" />
  </VisibilityConstraints>

  <Symbols>
    <GuidSymbol name="ContentType" value="{5b2dc8c1-5049-43fb-b02a-376196cec872}" />
    <GuidSymbol name="CSVEditor" value="{55b9ed45-59d1-40dc-8003-343d792221d7}">
      <IDSymbol name="CsvContextMenuGroup" value="0x0002" />
      <IDSymbol name="GoToColumnCommand" value="0x0100" />
      <IDSymbol name="AlignColumnsCommand" value="0x0101" />
      <IDSymbol name="ShrinkColumnsCommand" value="0x0102" />
      <IDSymbol name="ToggleAlternateRowsCommand" value="0x0103" />
      <IDSymbol name="CopyAsMarkdownCommand" value="0x0104" />
    </GuidSymbol>
  </Symbols>
</CommandTable>
